[
  {
    "namespace": "magicThreadsWindow",
    "functions": [
      {
        "name": "showBanner",
        "type": "function",
        "async": true,
        "description": "Affiche ou met à jour le panneau de fil de discussion dans le message pane d'un onglet mail.",
        "parameters": [
          {
            "name": "tabId",
            "type": "integer",
            "description": "ID de l'onglet mail cible."
          },
          {
            "name": "threadData",
            "type": "array",
            "description": "Messages du fil de discussion (métadonnées uniquement).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "ID WebExtension du message."
                },
                "headerMessageId": {
                  "type": "string",
                  "optional": true,
                  "description": "Message-ID de l'en-tête."
                },
                "author": {
                  "type": "string",
                  "optional": true,
                  "description": "Expéditeur (en-tête From)."
                },
                "date": {
                  "type": "number",
                  "description": "Timestamp en millisecondes."
                },
                "folder": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Dossier contenant le message.",
                  "properties": {
                    "accountId": { "type": "string", "optional": true },
                    "path": { "type": "string", "optional": true },
                    "type": { "type": "string", "optional": true }
                  }
                },
                "snippet": {
                  "type": "string",
                  "optional": true,
                  "description": "Extrait du corps du message (texte brut)."
                },
                "isRead": {
                  "type": "boolean",
                  "optional": true
                },
                "hasAttachments": {
                  "type": "boolean",
                  "optional": true
                },
                "tags": {
                  "type": "array",
                  "optional": true,
                  "items": { "type": "string" }
                },
                "isManualLink": {
                  "type": "boolean",
                  "optional": true,
                  "description": "Indique si le message provient d'une liaison manuelle."
                },
                "manualLinkId": {
                  "type": "string",
                  "optional": true,
                  "description": "Identifiant unique de la liaison manuelle."
                }
              }
            }
          },
          {
            "name": "currentMessageId",
            "type": "integer",
            "description": "ID WebExtension du message actuellement affiché."
          },
          {
            "name": "navigationMode",
            "type": "string",
            "enum": ["currentTab", "newTab"],
            "description": "Mode de navigation au clic sur un message du fil."
          },
          {
            "name": "sidebarPosition",
            "type": "string",
            "enum": ["left", "right"],
            "description": "Position du sidebar en onglet message."
          },
          {
            "name": "mainViewPosition",
            "type": "string",
            "enum": ["bottom", "right"],
            "description": "Position du panneau en vue principale 3-pane."
          },
          {
            "name": "labels",
            "type": "object",
            "additionalProperties": false,
            "description": "Chaînes i18n pour le rendu du panneau (les clés absentes retombent sur les libellés par défaut).",
            "properties": {
              "panelTitle": { "type": "string", "optional": true },
              "modeCurrentTab": { "type": "string", "optional": true },
              "modeNewTab": { "type": "string", "optional": true },
              "tooltipCurrentTab": { "type": "string", "optional": true },
              "tooltipNewTab": { "type": "string", "optional": true },
              "tooltipToggleMode": { "type": "string", "optional": true },
              "tooltipCollapseExpand": { "type": "string", "optional": true },
              "tooltipResize": { "type": "string", "optional": true },
              "tooltipAttachment": { "type": "string", "optional": true },
              "folderInbox": { "type": "string", "optional": true },
              "folderSent": { "type": "string", "optional": true },
              "folderArchive": { "type": "string", "optional": true },
              "folderDrafts": { "type": "string", "optional": true },
              "folderTrash": { "type": "string", "optional": true },
              "unknownAuthor": { "type": "string", "optional": true },
              "unreadLabel": { "type": "string", "optional": true },
              "stagingBannerTitle": { "type": "string", "optional": true },
              "stagingBannerPromptSingle": { "type": "string", "optional": true },
              "stagingBannerPromptThread": { "type": "string", "optional": true },
              "stagingSourceLabel": { "type": "string", "optional": true },
              "stagingOptionMergeThreads": { "type": "string", "optional": true },
              "stagingOptionSingleMsg": { "type": "string", "optional": true },
              "btnConfirmLink": { "type": "string", "optional": true },
              "btnCancelLink": { "type": "string", "optional": true },
              "badgeManualLink": { "type": "string", "optional": true },
              "btnDetachLink": { "type": "string", "optional": true },
              "confirmDetachPrompt": { "type": "string", "optional": true }
            }
          },
          {
            "name": "stagingData",
            "type": "object",
            "optional": true,
            "additionalProperties": false,
            "description": "Données d'association manuelle en cours (mode staging).",
            "properties": {
              "sourceHeaderId": { "type": "string", "optional": true, "description": "Message-ID RFC 822 du message source." },
              "sourceSubject": { "type": "string", "optional": true },
              "sourceAuthor": { "type": "string", "optional": true },
              "sourceCount": { "type": "integer", "optional": true },
              "isSourceInThread": { "type": "boolean", "optional": true },
              "sourceThreadCount": { "type": "integer", "optional": true }
            }
          }
        ]
      },
      {
        "name": "hideBanner",
        "type": "function",
        "async": true,
        "description": "Masque le panneau de fil de discussion.",
        "parameters": [
          {
            "name": "tabId",
            "type": "integer",
            "description": "ID de l'onglet mail cible."
          }
        ]
      },
      {
        "name": "navigateMessageTab",
        "type": "function",
        "async": true,
        "description": "Remplace le contenu d'un onglet message par un autre message (l'onglet est recréé à l'identique). Résout à true en cas de succès.",
        "parameters": [
          {
            "name": "tabId",
            "type": "integer",
            "description": "ID de l'onglet message cible."
          },
          {
            "name": "messageId",
            "type": "integer",
            "description": "ID WebExtension du message à afficher."
          }
        ]
      },
      {
        "name": "displayMessageDirectly",
        "type": "function",
        "async": true,
        "description": "Affiche directement un message dans le visualiseur d'un onglet (vue 3-pane ou onglet message) sans dépendre de la sélection dans la liste.",
        "parameters": [
          {
            "name": "tabId",
            "type": "integer",
            "description": "ID de l'onglet cible."
          },
          {
            "name": "messageId",
            "type": "integer",
            "description": "ID WebExtension du message à afficher."
          }
        ]
      }
    ],
    "events": [
      {
        "name": "onBannerItemClicked",
        "type": "function",
        "description": "Déclenché quand l'utilisateur clique sur un message du fil dans le panneau.",
        "parameters": [
          {
            "name": "messageId",
            "type": "integer",
            "description": "ID WebExtension du message cliqué."
          },
          {
            "name": "mode",
            "type": "string",
            "enum": ["currentTab", "newTab"],
            "description": "Mode de navigation au moment du clic."
          }
        ]
      },
      {
        "name": "onConfirmManualLink",
        "type": "function",
        "description": "Déclenché quand l'utilisateur confirme l'association dans la bannière de staging.",
        "parameters": [
          {
            "name": "scope",
            "type": "string",
            "enum": ["entire_thread", "single_message"],
            "description": "Portée de l'association retenue."
          }
        ]
      },
      {
        "name": "onCancelManualLink",
        "type": "function",
        "description": "Déclenché quand l'utilisateur annule le mode d'association.",
        "parameters": []
      },
      {
        "name": "onDetachManualLink",
        "type": "function",
        "description": "Déclenché quand l'utilisateur détache un message du fil.",
        "parameters": [
          {
            "name": "manualLinkId",
            "type": "string",
            "description": "Identifiant de la liaison à révoquer."
          }
        ]
      }
    ]
  }
]
