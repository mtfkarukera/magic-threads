[
  {
    "namespace": "magicThreadsWindow",
    "functions": [
      {
        "name": "showBanner",
        "type": "function",
        "async": true,
        "description": "Affiche ou met à jour le panneau de fil de discussion dans le message pane d'un onglet mail.",
        "parameters": [
          {
            "name": "tabId",
            "type": "integer",
            "description": "ID de l'onglet mail cible."
          },
          {
            "name": "threadData",
            "type": "array",
            "description": "Messages du fil de discussion (métadonnées uniquement).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "ID WebExtension du message."
                },
                "headerMessageId": {
                  "type": "string",
                  "optional": true,
                  "description": "Message-ID de l'en-tête."
                },
                "author": {
                  "type": "string",
                  "optional": true,
                  "description": "Expéditeur (en-tête From)."
                },
                "date": {
                  "type": "number",
                  "description": "Timestamp en millisecondes."
                },
                "folder": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Dossier contenant le message.",
                  "properties": {
                    "accountId": { "type": "string", "optional": true },
                    "path": { "type": "string", "optional": true },
                    "type": { "type": "string", "optional": true }
                  }
                },
                "snippet": {
                  "type": "string",
                  "optional": true,
                  "description": "Extrait du corps du message (texte brut)."
                },
                "isRead": {
                  "type": "boolean",
                  "optional": true
                },
                "hasAttachments": {
                  "type": "boolean",
                  "optional": true
                },
                "tags": {
                  "type": "array",
                  "optional": true,
                  "items": { "type": "string" }
                }
              }
            }
          },
          {
            "name": "currentMessageId",
            "type": "integer",
            "description": "ID WebExtension du message actuellement affiché."
          },
          {
            "name": "navigationMode",
            "type": "string",
            "enum": ["currentTab", "newTab"],
            "description": "Mode de navigation au clic sur un message du fil."
          },
          {
            "name": "sidebarPosition",
            "type": "string",
            "enum": ["left", "right"],
            "description": "Position du sidebar en onglet message."
          },
          {
            "name": "mainViewPosition",
            "type": "string",
            "enum": ["bottom", "right"],
            "description": "Position du panneau en vue principale 3-pane."
          },
          {
            "name": "labels",
            "type": "object",
            "additionalProperties": false,
            "description": "Chaînes i18n pour le rendu du panneau (les clés absentes retombent sur les libellés par défaut).",
            "properties": {
              "panelTitle": { "type": "string", "optional": true },
              "modeCurrentTab": { "type": "string", "optional": true },
              "modeNewTab": { "type": "string", "optional": true },
              "tooltipCurrentTab": { "type": "string", "optional": true },
              "tooltipNewTab": { "type": "string", "optional": true },
              "tooltipToggleMode": { "type": "string", "optional": true },
              "tooltipCollapseExpand": { "type": "string", "optional": true },
              "tooltipResize": { "type": "string", "optional": true },
              "tooltipAttachment": { "type": "string", "optional": true },
              "folderInbox": { "type": "string", "optional": true },
              "folderSent": { "type": "string", "optional": true },
              "folderArchive": { "type": "string", "optional": true },
              "folderDrafts": { "type": "string", "optional": true },
              "folderTrash": { "type": "string", "optional": true },
              "unknownAuthor": { "type": "string", "optional": true },
              "unreadLabel": { "type": "string", "optional": true }
            }
          }
        ]
      },
      {
        "name": "hideBanner",
        "type": "function",
        "async": true,
        "description": "Masque le panneau de fil de discussion.",
        "parameters": [
          {
            "name": "tabId",
            "type": "integer",
            "description": "ID de l'onglet mail cible."
          }
        ]
      },
      {
        "name": "navigateMessageTab",
        "type": "function",
        "async": true,
        "description": "Remplace le contenu d'un onglet message par un autre message (l'onglet est recréé à l'identique). Résout à true en cas de succès.",
        "parameters": [
          {
            "name": "tabId",
            "type": "integer",
            "description": "ID de l'onglet message cible."
          },
          {
            "name": "messageId",
            "type": "integer",
            "description": "ID WebExtension du message à afficher."
          }
        ]
      }
    ],
    "events": [
      {
        "name": "onBannerItemClicked",
        "type": "function",
        "description": "Déclenché quand l'utilisateur clique sur un message du fil dans le panneau.",
        "parameters": [
          {
            "name": "messageId",
            "type": "integer",
            "description": "ID WebExtension du message cliqué."
          },
          {
            "name": "mode",
            "type": "string",
            "enum": ["currentTab", "newTab"],
            "description": "Mode de navigation au moment du clic."
          }
        ]
      }
    ]
  }
]
