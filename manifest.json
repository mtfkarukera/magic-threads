{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "2.2.2",
  "description": "__MSG_extensionDescription__",
  "default_locale": "fr",
  "author": "Antigravity",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["background/background.js"],
    "type": "module"
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "storage"
  ],
  "experiment_apis": {
    "convGloda": {
      "schema": "experiment-api/glodaSchema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["convGloda"]],
        "script": "experiment-api/glodaApi.js"
      }
    },
    "magicThreadsWindow": {
      "schema": "experiment-api/magicThreadsWindowSchema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["magicThreadsWindow"]],
        "script": "experiment-api/magicThreadsWindowApi.js"
      }
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "magic-threads@mtfkarukera.net",
      "strict_min_version": "128.0",
      "strict_max_version": "151.*"
    }
  }
}
